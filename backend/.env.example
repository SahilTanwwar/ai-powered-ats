# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000

# URL of the deployed frontend (used for CORS allow-list)
FRONTEND_URL=http://localhost:5173

# ─── SECURITY ─────────────────────────────────────────────────────────────────
# REQUIRED — app exits if missing. Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret

# ─── DATABASE (PostgreSQL) ────────────────────────────────────────────────────
# Full connection string — takes precedence when set
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Optional individual fields (used by env.js config if DATABASE_URL is absent)
DB_HOST=localhost
DB_NAME=ats_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_DIALECT=postgres

# ─── DATABASE SYNC (Sequelize) ────────────────────────────────────────────────
# Set DB_SYNC_FORCE=true ONLY on first run to create tables (destructive!)
DB_SYNC_FORCE=false
# Set DB_SYNC_ALTER=true to add missing columns without dropping data
DB_SYNC_ALTER=false

# ─── AI (Google Gemini) ───────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ─── EMAIL (SMTP / Nodemailer) ────────────────────────────────────────────────
# Leave blank to disable email features (app continues to work without it)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail: use an App Password, not your account password
# https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_app_password
