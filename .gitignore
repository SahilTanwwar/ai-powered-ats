# ─── Node modules ─────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ─── Environment files (NEVER commit these) ───────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
# Allow example files to be committed
!backend/.env.example
!frontend/.env.example
!.env.example

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
frontend/dist/
frontend/build/
backend/dist/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
logs/
*.log.*

# ─── OS & Editor files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ─── Uploads (user-generated runtime files) ───────────────────────────────────
backend/uploads/
uploads/

# ─── Misc ─────────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.tsbuildinfo
